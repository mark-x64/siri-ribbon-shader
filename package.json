{
  "name": "siri-ribbon-shader",
  "version": "1.0.0",
  "private": true,
  "description": "A procedural iridescent ribbon in GLSL and Metal.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:reference": "vite --mode reference --host 127.0.0.1",
    "build": "npm run check:shaders && vite build && node scripts/check-public-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "sync:shaders": "node scripts/sync-shaders.mjs",
    "check:shaders": "node scripts/sync-shaders.mjs --check"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  }
}
